---
import { servicios } from "../data/servicios.js";
import { enlaceWhatsApp } from "../scripts/whatsapp.js";
---
<section id="servicios" class="section-spacing services-section" aria-labelledby="servicios-titulo">
  <div class="container">
    <div class="section-heading text-center">
      <p class="eyebrow mb-1">Servicios veterinarios</p>
      <h2 id="servicios-titulo" class="mt-1">Atención para tu mascota</h2>
      <p class="text-muted">
        Consulta general, vacunas, desparasitación y seguimiento clínico para perros y gatos.
      </p>
    </div>

    <!-- Rejilla de servicios -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-4 mb-4">
      {servicios.map(servicio => (
        <div class="col">
          <article class="service-card-renovada h-100 d-flex flex-column">
            
            <!-- Barra superior: Categoría y Duración -->
            <div class="service-card-top d-flex justify-content-between align-items-center mb-3">
              <span class="service-category-badge">{servicio.categoria}</span>
              <span class="service-duration-badge">{servicio.duracion}</span>
            </div>

            <!-- Ícono y Título -->
            <div class="service-icon-box mb-3" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={servicio.icono} />
              </svg>
            </div>
            
            <h3 class="service-card-title h6 fw-bold mb-2">{servicio.titulo}</h3>
            <p class="service-card-desc text-muted small mb-3">{servicio.descripcion}</p>

            <!-- Lista de puntos incluidos -->
            <ul class="service-features-list list-unstyled mb-3 flex-grow-1">
              {servicio.caracteristicas.map(item => (
                <li class="d-flex align-items-start gap-2 mb-1 small text-muted">
                  <span class="service-check-icon" aria-hidden="true">—</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>

            <!-- Botón de agendar -->
            <div class="service-card-action pt-2 border-top">
              <button 
                type="button"
                class="btn btn-service-select w-100" 
                data-abrir-modal-cita
                data-servicio={servicio.id} 
                aria-label={"Elegir servicio " + servicio.titulo}
              >
                <span>Elegir servicio</span>
                <span aria-hidden="true">→</span>
              </button>
            </div>

          </article>
        </div>
      ))}
    </div>

    <!-- Barra de consulta rápida inferior -->
    <div class="services-support-banner d-flex flex-wrap align-items-center justify-content-between p-3 rounded border">
      <div>
        <strong class="d-block text-dark">¿Tienes dudas sobre qué servicio necesitas?</strong>
        <small class="text-muted">Escríbenos por WhatsApp para orientarte con la reserva de tu cita.</small>
      </div>
      <a class="btn btn-support-whatsapp mt-2 mt-md-0" href={enlaceWhatsApp()} target="_blank" rel="noopener noreferrer">
        <span>Consultar por WhatsApp</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>
