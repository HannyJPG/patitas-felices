---
const testimonios = [
  {
    id: 1,
    autor: "Carlos Méndez",
    mascota: "Rocky",
    especie: "Golden Retriever",
    servicio: "Consulta y Vacunación",
    estrellas: 5,
    avatarColor: "var(--color-peach)",
    texto: "Buena atención y paciencia con Rocky en su consulta de vacunas. La doctora explicó bien el calendario de refuerzos."
  },
  {
    id: 2,
    autor: "Valeria Gómez",
    mascota: "Michi",
    especie: "Siamés",
    servicio: "Control y Desparasitación",
    estrellas: 5,
    avatarColor: "var(--color-aqua)",
    texto: "Trato tranquilo con Michi, que suele ponerse nervioso en las revisiones. Nos orientaron bien sobre el cuidado de su peso."
  },
  {
    id: 3,
    autor: "Lucía Fernández",
    mascota: "Luna",
    especie: "Poodle Toy",
    servicio: "Chequeo Anual",
    estrellas: 5,
    avatarColor: "var(--color-gold)",
    texto: "Agendé la cita por la página y la confirmación por WhatsApp llegó puntual. Revisión completa y sin demoras."
  },
  {
    id: 4,
    autor: "Ricardo Ramos",
    mascota: "Toby",
    especie: "Labrador",
    servicio: "Seguimiento Clínico",
    estrellas: 5,
    avatarColor: "var(--color-peach)",
    texto: "Instalaciones ordenadas y limpias. La evolución de Toby con el tratamiento recetado fue buena y rápida."
  },
  {
    id: 5,
    autor: "Camila Torres",
    mascota: "Simón",
    especie: "Gato común",
    servicio: "Vacunación",
    estrellas: 5,
    avatarColor: "var(--color-aqua)",
    texto: "Atención organizada con el carnet de vacunas y buenos consejos para la alimentación de Simón."
  },
  {
    id: 6,
    autor: "Diego Salazar",
    mascota: "Bruno",
    especie: "Bulldog Francés",
    servicio: "Dermatología",
    estrellas: 5,
    avatarColor: "var(--color-gold)",
    texto: "Nos ayudaron a encontrar el tratamiento para el problema de piel de Bruno. Buen seguimiento del caso."
  },
  {
    id: 7,
    autor: "Elena Morales",
    mascota: "Cleo",
    especie: "Cocker Spaniel",
    servicio: "Limpieza Dental",
