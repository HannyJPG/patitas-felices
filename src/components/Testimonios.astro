---
<section id="testimonios" class="section-spacing testimonials-section" aria-labelledby="testimonios-titulo">
  <div class="container">
    
    <div class="mb-4">
      <h2 id="testimonios-titulo" class="mt-1 mb-1">Comentarios de clientes</h2>
      <p class="text-muted mb-0">Experiencias de familias que atienden a sus mascotas en la clínica.</p>
    </div>

    <div class="testimonial-slider-wrapper position-relative" id="slider-testimonios-contenedor">
      <div class="testimonial-slider-track" id="slider-testimonios-pista" role="region" aria-label="Carrusel de testimonios" aria-live="polite">
        {testimonios.map((t, idx) => (
          <article class="testimonial-card-item" data-card-idx={idx}>
            <div class="testimonial-card-inner h-100 d-flex flex-column justify-content-between border rounded p-3">
              
              <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="small fw-semibold text-warning" aria-label="5 de 5 estrellas">
                    ★★★★★
                  </span>
                  <span class="testimonial-service-tag">{t.servicio}</span>
                </div>
                
                <p class="testimonial-quote-text mb-3 small">
                  “{t.texto}”
                </p>
              </div>

              <div class="testimonial-author-box pt-2 border-top d-flex align-items-center gap-2">
                <div class="testimonial-avatar" style={`background-color: ${t.avatarColor};`}>
                  {t.autor.charAt(0)}
                </div>
                <div class="min-w-0">
                  <strong class="d-block text-dark small text-truncate">{t.autor}</strong>
                  <span class="testimonial-pet-badge small">{t.mascota} ({t.especie})</span>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="testimonial-mobile-controls d-md-none d-flex justify-content-center align-items-center gap-3 mt-3">
      <button 
        type="button" 
        class="btn btn-outline-primary btn-sm testimonial-nav-btn" 
        id="btn-testimonios-prev" 
        aria-label="Ver opinión anterior"
      >
        <span aria-hidden="true">←</span>
      </button>

      <span id="indicador-testimonios-mobile" class="small text-muted fw-semibold">1 / 7</span>

      <button 
        type="button" 
        class="btn btn-outline-primary btn-sm testimonial-nav-btn" 
        id="btn-testimonios-next" 
        aria-label="Ver opinión siguiente"
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>

  </div>
</section>

<script>
  (() => {
    const contenedor = document.getElementById("slider-testimonios-contenedor");
    const pista = document.getElementById("slider-testimonios-pista");
    const btnPrev = document.getElementById("btn-testimonios-prev");
    const btnNext = document.getElementById("btn-testimonios-next");
    const indicadorMobile = document.getElementById("indicador-testimonios-mobile");

    if (!pista || !contenedor) return;

    const totalTarjetas = 7;
    let indiceActual = 0;
    let temporizador = null;

    function obtenerTarjetasVisibles() {
      const ancho = window.innerWidth;
      if (ancho >= 992) return 4;
      if (ancho >= 768) return 2;
      return 1;
    }

    function actualizarPosicion() {
      const visibles = obtenerTarjetasVisibles();
      const tarjetas = pista.querySelectorAll(".testimonial-card-item");
      if (tarjetas.length === 0) return;

      const maxIndice = totalTarjetas - visibles;
      if (indiceActual > maxIndice) {
        indiceActual = 0;
      } else if (indiceActual < 0) {
        indiceActual = maxIndice;
      }

      const primerTarjeta = tarjetas[0];
      const estiloGap = parseFloat(window.getComputedStyle(pista).gap) || 20;
      const anchoPaso = primerTarjeta.offsetWidth + estiloGap;

      pista.style.transform = `translateX(-${indiceActual * anchoPaso}px)`;

      if (indicadorMobile) {
        indicadorMobile.textContent = `${indiceActual + 1} / ${totalTarjetas}`;
      }
    }

    function avanzar() {
      const visibles = obtenerTarjetasVisibles();
      const maxIndice = totalTarjetas - visibles;
      if (indiceActual >= maxIndice) {
        indiceActual = 0;
      } else {
        indiceActual += 1;
      }
      actualizarPosicion();
    }

    function retroceder() {
      const visibles = obtenerTarjetasVisibles();
      const maxIndice = totalTarjetas - visibles;
      if (indiceActual <= 0) {
        indiceActual = maxIndice;
      } else {
        indiceActual -= 1;
      }
      actualizarPosicion();
    }

    function iniciarRotacion() {
      detenerRotacion();
      temporizador = window.setInterval(() => {
        avanzar();
      }, 5000);
    }

    function detenerRotacion() {
      if (temporizador) {
        window.clearInterval(temporizador);
        temporizador = null;
      }
    }

    btnNext?.addEventListener("click", () => {
      avanzar();
      iniciarRotacion();
    });

    btnPrev?.addEventListener("click", () => {
      retroceder();
      iniciarRotacion();
    });

    let startX = 0;
    let endX = 0;

    contenedor.addEventListener("touchstart", (e) => {
      startX = e.touches[0].clientX;
      detenerRotacion();
    }, { passive: true });

    contenedor.addEventListener("touchend", (e) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          avanzar();
        } else {
          retroceder();
        }
      }
      iniciarRotacion();
    }, { passive: true });

    contenedor.addEventListener("mouseenter", () => detenerRotacion());
    contenedor.addEventListener("mouseleave", () => iniciarRotacion());
    contenedor.addEventListener("focusin", () => detenerRotacion());
    contenedor.addEventListener("focusout", () => iniciarRotacion());

    window.addEventListener("resize", () => {
      actualizarPosicion();
    });

    actualizarPosicion();
    iniciarRotacion();
  })();
</script>
