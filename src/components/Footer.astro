---
import { clinica } from "../data/clinica.js";
import { enlaceWhatsApp } from "../scripts/whatsapp.js";
const anio = new Intl.DateTimeFormat("es-PE", { timeZone: "America/Lima", year: "numeric" }).format(new Date());
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-compact-wrap d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 py-3">
      
      <!-- Marca y contacto directo -->
      <div class="footer-brand-compact d-flex align-items-center gap-2">
        <span class="footer-brand-name">Patitas Felices</span>
        <span class="text-white-50">·</span>
        <a class="footer-phone-compact" href={enlaceWhatsApp()} target="_blank" rel="noopener noreferrer" aria-label="Contacto WhatsApp de la clínica">
          <span>{clinica.telefonoVisible}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- Navegación limpia y directa -->
      <nav class="footer-nav-compact d-flex flex-wrap align-items-center justify-content-center gap-3" aria-label="Navegación del pie de página">
        <a href="/">Inicio</a>
        <a href="/#servicios">Servicios</a>
        <a href="/#sedes">Sedes</a>
        <a href="/tienda">Tienda</a>
        <a href="#modalAgendarCita" data-abrir-modal-cita>Agendar cita</a>
        <a href="/perfil">Mi Perfil</a>
      </nav>

      <!-- Copyright discreto -->
      <div class="footer-copy-compact text-center text-md-end text-white-50 small">
        &copy; {anio} Patitas Felices. Todos los derechos reservados.
      </div>

    </div>
  </div>
</footer>
