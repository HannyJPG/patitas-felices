---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ModalAgendarCita from "../components/ModalAgendarCita.astro";
import { enlaceWhatsApp } from "../scripts/whatsapp.js";
interface Props { title: string; inicio?: boolean; }
const { title, inicio = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B2545" />
    <meta name="description" content="Clínica veterinaria Patitas Felices: conoce nuestros servicios y solicita una cita de 30 minutos para tu mascota por WhatsApp." />
    <title>{title}</title>
    <link rel="icon" href="/img/icono-opcion2-emblema-circular.png" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="paw-tracks-background" aria-hidden="true">
      
      <div class="paw-trail trail-dog-diagonal">
        <span class="paw-print paw-dog t1-s1"></span>
        <span class="paw-print paw-dog t1-s2"></span>
        <span class="paw-print paw-dog t1-s3"></span>
        <span class="paw-print paw-dog t1-s4"></span>
        <span class="paw-print paw-dog t1-s5"></span>
        <span class="paw-print paw-dog t1-s6"></span>
        <span class="paw-print paw-dog t1-s7"></span>
        <span class="paw-print paw-dog t1-s8"></span>
      </div>

      <div class="paw-trail trail-cat-horizontal">
        <span class="paw-print paw-cat t2-s1"></span>
        <span class="paw-print paw-cat t2-s2"></span>
        <span class="paw-print paw-cat t2-s3"></span>
        <span class="paw-print paw-cat t2-s4"></span>
        <span class="paw-print paw-cat t2-s5"></span>
        <span class="paw-print paw-cat t2-s6"></span>
        <span class="paw-print paw-cat t2-s7"></span>
        <span class="paw-print paw-cat t2-s8"></span>
      </div>

      <div class="paw-trail trail-playful-curve">
        <span class="paw-print paw-dog t3-s1"></span>
        <span class="paw-print paw-cat t3-s2"></span>
        <span class="paw-print paw-dog t3-s3"></span>
        <span class="paw-print paw-cat t3-s4"></span>
        <span class="paw-print paw-dog t3-s5"></span>
        <span class="paw-print paw-cat t3-s6"></span>
        <span class="paw-print paw-dog t3-s7"></span>
        <span class="paw-print paw-cat t3-s8"></span>
      </div>

    </div>

    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header inicio={inicio} />
    <slot />
    <Footer />
    <ModalAgendarCita />

    <aside class="floating-cat-container" aria-label="Contacto rápido por WhatsApp">
      <a 
        href={enlaceWhatsApp("¡Hola Patitas Felices! Quisiera consultar por la atención veterinaria de mi mascota.")} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="floating-cat-btn"
        id="btn-flotante-gatito"
        title="¡Contáctanos aquí por WhatsApp!"
        aria-label="¡Contáctanos aquí por WhatsApp!"
      >
        <div class="cat-speech-bubble" aria-hidden="true">
          <span class="cat-bubble-pulse"></span>
          <span>¡Contáctanos aquí!</span>
        </div>

        <div class="cat-avatar-wrap">
          <svg class="cat-svg" viewBox="0 0 100 100" width="76" height="76" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="catBodyGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#FFA868" />
                <stop offset="100%" stop-color="#E89B5B" />
              </linearGradient>
              <linearGradient id="catCheekGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#FFF5EC" />
                <stop offset="100%" stop-color="#FFE0CC" />
              </linearGradient>
            </defs>

            <ellipse cx="50" cy="88" rx="28" ry="6" fill="rgba(11,37,69,0.18)" />

            <path d="M30 84 C30 64 36 52 50 52 C64 52 70 64 70 84 C70 88 30 88 30 84 Z" fill="url(#catBodyGrad)" />
            <path d="M42 66 C42 56 46 54 50 54 C54 54 58 56 58 66 C58 78 42 78 42 66 Z" fill="#FFFBF5" />

            <ellipse cx="38" cy="84" rx="7" ry="5" fill="#FFFBF5" stroke="#E89B5B" stroke-width="1.5" />

            <path class="cat-tail" d="M68 80 C78 78 86 70 84 60 C83 55 78 57 77 62 C76 67 71 74 65 77" fill="none" stroke="#E89B5B" stroke-width="4.5" stroke-linecap="round" />

            <polygon points="32,38 25,18 42,26" fill="#E89B5B" />
            <polygon points="32,35 28,22 39,28" fill="#FFB7B2" />
            <polygon points="68,38 75,18 58,26" fill="#E89B5B" />
            <polygon points="68,35 72,22 61,28" fill="#FFB7B2" />

            <circle cx="50" cy="42" r="22" fill="url(#catBodyGrad)" />
            <ellipse cx="44" cy="47" rx="6" ry="4" fill="url(#catCheekGrad)" />
            <ellipse cx="56" cy="47" rx="6" ry="4" fill="url(#catCheekGrad)" />

            <ellipse cx="41" cy="38" rx="3" ry="4" fill="#0B2545" />
            <circle cx="42" cy="36" r="1.2" fill="#FFFFFF" />
            <ellipse cx="59" cy="38" rx="3" ry="4" fill="#0B2545" />
            <circle cx="60" cy="36" r="1.2" fill="#FFFFFF" />

            <polygon points="50,44 47.5,41.5 52.5,41.5" fill="#FF7B7B" />

            <path class="cat-tongue" d="M50 46 C48 46 48 50 50 51 C52 50 52 46 50 46 Z" fill="#FF5252" />

            <path d="M46 46 Q48.5 48.5 50 46 Q51.5 48.5 54 46" fill="none" stroke="#684323" stroke-width="1.3" stroke-linecap="round" />

            <line x1="33" y1="42" x2="22" y2="40" stroke="#8C5832" stroke-width="1" stroke-linecap="round" />
            <line x1="33" y1="45" x2="23" y2="46" stroke="#8C5832" stroke-width="1" stroke-linecap="round" />
            <line x1="67" y1="42" x2="78" y2="40" stroke="#8C5832" stroke-width="1" stroke-linecap="round" />
            <line x1="67" y1="45" x2="77" y2="46" stroke="#8C5832" stroke-width="1" stroke-linecap="round" />

            <g class="cat-paw-licking-group">
              <path d="M60 76 C62 66 65 58 58 54 C53 51 51 55 53 60 C55 65 57 74 60 84" fill="#FFA868" stroke="#E89B5B" stroke-width="1" />
              <ellipse cx="55" cy="54" rx="5" ry="4" fill="#FFFBF5" stroke="#E89B5B" stroke-width="1.2" />
              <circle cx="53.5" cy="53" r="1" fill="#FFB7B2" />
              <circle cx="56.5" cy="53" r="1" fill="#FFB7B2" />
            </g>
          </svg>
        </div>
      </a>
    </aside>

    <script is:inline src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
      import "../scripts/main.js";
      import "../scripts/modal-agendar-cita.js";
    </script>
  </body>
</html>
