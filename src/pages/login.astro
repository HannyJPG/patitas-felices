---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Iniciar sesión | Patitas Felices">
  <main class="container section-spacing text-center" id="contenido" tabindex="-1">
    <div class="status-panel mx-auto my-5 p-4 p-md-5" style="max-width: 38rem;">
      <span class="modal-chip-tag mb-3">Acceso Integrado</span>
      <h1 class="h3 fw-bold mb-3">Iniciar Sesión en Patitas Felices</h1>
      <p class="text-muted mb-4">
        El inicio de sesión ahora se gestiona directamente desde la ventana modal integrada en la barra superior de navegación.
      </p>
      
      <div class="d-flex flex-wrap justify-content-center gap-2">
        <button type="button" class="btn btn-primary" data-abrir-login>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-1">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          Abrir modal de inicio de sesión
        </button>
        <a href="/" class="btn btn-outline-primary">
          Ir al Inicio
        </a>
      </div>
    </div>
  </main>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.querySelector("[data-abrir-login]");
      if (btn) {
        setTimeout(() => btn.click(), 100);
      }
    });
  </script>
</Layout>
